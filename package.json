{
  "name": "gamemaster-builder",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000} -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:node && npm run test:vitest",
    "test:node": "node --import tsx --test lib/generators/__tests__/*.test.ts lib/__tests__/*.test.ts lib/world/__tests__/*.test.ts",
    "test:vitest": "vitest run",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project player-mode-rules-test \"vitest run lib/playerMode/__tests__/rules.test.ts\"",
    "deploy:rules": "firebase deploy --only firestore:rules,storage --project campaign-prep-fc9ed --non-interactive",
    "deploy:firestore": "firebase deploy --only firestore,storage --project campaign-prep-fc9ed --non-interactive"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@xyflow/react": "^12.10.2",
    "d3-force": "^3.0.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "jose": "^5.10.0",
    "konva": "^10.3.0",
    "lucide-react": "^0.577.0",
    "nanoid": "^5.1.11",
    "next": "^15.5.18",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-konva": "^19.2.4",
    "stripe": "^22.1.1",
    "use-image": "^1.1.4",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.30",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.7.0",
    "eslint-config-next": "^16.2.11",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "fast-check": "^4.9.0",
    "firebase-tools": "^15.24.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.21",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
